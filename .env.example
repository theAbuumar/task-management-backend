# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Validated at boot by src/config (Zod); invalid/missing values fail fast.

# Runtime: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000

# Log level: fatal|error|warn|info|debug|trace|silent (optional; defaults by env)
LOG_LEVEL=debug

# ─── Demo stand (Ф13) ─────────────────────────────────────────────────────────
# Quick login as the seeded @demo.local accounts (npm run demo:reset). Never on real data.
# DEMO_MODE=true
# The presenter's Telegram user id (ask @userinfobot) — the demo seed links it to one
# demo account so bot messages and buttons reach the phone. Must not be linked to a
# real account in the same database. Role: rector | prorector | dean | employee.
# DEMO_TELEGRAM_ID=123456789
# DEMO_TELEGRAM_ROLE=dean

# Analytics (Ф10): seconds to keep the dashboard's loaded facts; any write to the
# workspace drops them earlier. 0 disables the cache.
ANALYTICS_CACHE_TTL=300

# PostgreSQL connection string (must start with postgres:// or postgresql://)
DATABASE_URL=postgresql://postgres:12345@localhost:5432/taskmgmt?schema=public

# JWT secrets — generate strong random values, e.g. `openssl rand -base64 48`
# Each must be at least 32 characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32

# Token lifetimes (JWT duration syntax: 15m, 7d, or seconds).
# Access token is short-lived and kept in SPA memory; the SPA refreshes it silently
# via the httpOnly refresh cookie (DECISIONS.md ADR-004).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Session cookie (refresh token) ───────────────────────────────────────────
SESSION_COOKIE_NAME=refresh_token
# SESSION_COOKIE_DOMAIN=example.com          # omit to scope to the exact host
# SESSION_COOKIE_SECURE=true                 # defaults on outside development
SESSION_COOKIE_SAMESITE=lax                  # lax | strict | none
# Which SameSite to use:
#   lax  — SPA and API on the SAME origin (recommended: proxy /api on the SPA host).
#   none — SPA on a DIFFERENT origin than the API (also requires HTTPS + Secure);
#          without it the refresh cookie and the Telegram `tg_session` cookie are
#          never sent back and silent refresh / Telegram login fail.

# Public URL of the SPA. OAuth/Telegram redirects AND every link in emails /
# Telegram messages (invites, tasks) point here — never at the API host.
FRONTEND_URL=http://localhost:5173

# ─── OAuth / Telegram providers (auth_tz.md §3, §4, §7) ───────────────────────
# Optional until each provider's flow is wired; required once enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=                       # bot username, without the leading @
# Shared secret for the webhook. When set, the /telegram/webhook route only accepts
# requests carrying a matching X-Telegram-Bot-Api-Secret-Token header (so only
# Telegram can post). Generate with `openssl rand -hex 32`; must match the value
# passed to setWebhook. Register the webhook with: npm run telegram:set-webhook -- https://your-domain.com
# TELEGRAM_WEBHOOK_SECRET=

# ─── Email / SMTP (OTP codes, invites; auth_tz.md §6) ─────────────────────────
# Optional. With SMTP_HOST unset, dev/test logs emails to the console; production
# WITHOUT SMTP_HOST throws on send (so configure this before enabling email login
# in prod). Any SMTP provider works — examples: Resend, SendGrid, Mailgun.
#   Resend:   host smtp.resend.com   · user "resend" · pass = API key (re_...)
#   SendGrid: host smtp.sendgrid.net · user "apikey" · pass = API key (SG....)
#   Mailgun:  host smtp.mailgun.org  · user postmaster@… · pass = SMTP password
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465                # 587 for STARTTLS
# SMTP_SECURE=true             # true for port 465; false for STARTTLS (587)
# SMTP_USER=resend
# SMTP_PASS=
# From address on outgoing mail (must be a verified sender/domain in prod)
# MAIL_FROM="Task Management <no-reply@yourdomain>"

# ─── AI assistant (Ф11, ADR-028) ──────────────────────────────────────────────
# Off by default: with AI_ENABLED=false nothing is sent anywhere and the UI has no
# AI elements. Task texts go to the provider (Anthropic) when it is on.
AI_ENABLED=false
# AI_PROVIDER=anthropic
# Key from console.anthropic.com — required when AI_ENABLED=true
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# Optional gateway in front of the provider API
# AI_BASE_URL=
# Successful AI requests per user per day (default 50)
# AI_DAILY_LIMIT=50
# Deadline of one AI request, ms (default 120000)
# AI_TIMEOUT_MS=120000

# CORS allowed origins: comma-separated list, or `*` for any (dev only).
# In production list the SPA origin(s); `*` logs a warning at startup.
CORS_ORIGIN=*

# ─── Attachment storage ───────────────────────────────────────────────────────
# Driver: `local` (disk, dev/test default) or `s3` (S3-compatible: AWS S3 / MinIO)
STORAGE_DRIVER=local
# Lifetime of presigned upload slots, in seconds (30–86400)
STORAGE_PRESIGN_TTL=900
# Lifetime of download links, in seconds (60–604800); default one day (ADR-027)
STORAGE_DOWNLOAD_TTL=86400
# Public base URL the API is reachable at (used to build local storage URLs)
PUBLIC_BASE_URL=http://localhost:3000
# Max accepted upload size in bytes (default 25 MiB)
ATTACHMENT_MAX_BYTES=26214400

# local driver — directory bytes are written to (gitignored)
LOCAL_STORAGE_DIR=./uploads

# s3 driver — required only when STORAGE_DRIVER=s3.
# For MinIO (see docker-compose): S3_ENDPOINT=http://localhost:9000, path-style on.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=attachments
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
