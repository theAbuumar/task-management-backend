generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  owner
  admin
  member
  guest
}

enum ProjectRole {
  admin
  member
  viewer
}

enum StateGroup {
  backlog
  unstarted
  started
  // "На проверке": the assignee handed the work in, the controller hasn't accepted
  // it yet (ADR-008). Counts as in-progress for progress/analytics.
  review
  completed
  cancelled
}

enum IssuePriority {
  none
  low
  medium
  high
  urgent
}

enum ModuleStatus {
  backlog
  in_progress
  paused
  completed
  cancelled
}

enum IssueLinkType {
  blocks
  blocked_by
  relates_to
  duplicates
}

// In-app notification kinds (TZ §5.18). Generated as a side effect of the
// events that already write the activity trail.
enum ProjectVisibility {
  public // every workspace member sees it
  private // only project members (+ workspace admins)
}

enum ProjectStatus {
  planned
  active
  paused
  completed
}

// A plain task vs. an "поручение" — an assignment with a controller who accepts
// the result (ADR-008).
// How often a recurring rule creates an issue (6.B4, ADR-030).
enum RecurrenceFrequency {
  daily
  weekly
  monthly
  quarterly
  yearly
}

enum IssueKind {
  task
  assignment
}

// Плановые отчёты (Ф10 10.B5, ADR-032): the documents of «Аналитика» (10.B4).
enum ReportKind {
  // «Справка об исполнении поручений», PDF.
  discipline
  // «Реестр поручений», XLSX.
  assignments
  // «Отчёт по проекту», PDF; exactly one project in the filters.
  project
}

// Always whole days before the day of sending.
enum ReportPeriod {
  previous_week
  previous_month
  previous_quarter
  last_30_days
}

enum ReportRunStatus {
  // Every recipient got it in every chosen channel they have.
  sent
  // Some deliveries failed.
  partial
  // The document was not made (the reason is in `error`).
  failed
}

// Outcome of a hand-in for review (Ф5).
enum ReviewDecision {
  pending
  approved
  returned
}

// Request to move an assignment's deadline (Ф5).
enum DeadlineRequestStatus {
  pending
  approved
  rejected
}

// The full list is fixed up front (ADR-020) so later phases don't alter the enum.
enum NotificationType {
  issue_assigned
  comment_added
  mentioned
  state_changed
  review_requested
  review_approved
  review_returned
  acknowledged
  due_soon
  overdue
  escalated
  deadline_change_requested
  deadline_change_decided
  invite_received
  report_ready
  digest
}

// ─── Auth: providers & login-flow enums (auth_tz.md §2) ──────────────────────

// A login method attached to an account. One user may have several.
enum AuthProvider {
  email
  google
  github
  telegram
}

// What an email OTP is being used for.
enum EmailOtpPurpose {
  signup
  login
  delete_account
}

// Lifecycle of a Telegram deep-link login token.
enum TelegramLoginStatus {
  pending
  confirmed
  expired
  used
}

// Lifecycle of an invite that targets an already-registered user.
enum MemberInviteStatus {
  pending
  accepted
  declined
  expired
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                    String   @id @default(uuid())
  // Nullable: Telegram-only accounts have no email (auth_tz.md §2). Still unique when present.
  email                 String?  @unique
  email_verified        Boolean  @default(false)
  // Nullable: accounts created via OAuth/Telegram have no password until they set one.
  password_hash         String?
  display_name          String
  // Full name, Russian order (Фамилия Имя Отчество). Optional for accounts created
  // before Ф3 / via providers; display_name stays the rendered name.
  last_name             String?
  first_name            String?
  middle_name           String?
  phone                 String?
  locale                String   @default("ru")
  timezone              String?
  avatar_url            String?
  // Ф8 8.B2: which events go to Telegram / email and quiet hours; null = defaults
  // (src/lib/notification-prefs.ts). In-app notifications are always on.
  notification_settings Json?
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  headed_departments        Department[]            @relation("DepartmentHead")
  controlled_issues         Issue[]                 @relation("IssueController")
  submitted_reviews         IssueReview[]           @relation("ReviewSubmittedBy")
  decided_reviews           IssueReview[]           @relation("ReviewDecidedBy")
  deadline_requests         DeadlineChangeRequest[] @relation("DeadlineRequestedBy")
  decided_deadline_requests DeadlineChangeRequest[] @relation("DeadlineDecidedBy")
  watched_issues            IssueWatcher[]
  identities                AuthIdentity[]
  refresh_tokens            RefreshToken[]
  sessions                  AuthSession[]
  workspace_memberships     WorkspaceMember[]
  project_memberships       ProjectMember[]
  owned_workspaces          Workspace[]             @relation("WorkspaceOwner")
  led_projects              Project[]               @relation("ProjectLead")
  led_modules               Module[]                @relation("ModuleLead")
  created_issues            Issue[]                 @relation("IssueCreatedBy")
  assigned_issues           IssueAssignee[]
  comments                  Comment[]
  activities                ActivityLog[]           @relation("ActivityActor")
  attachments               Attachment[]
  notifications             Notification[]          @relation("NotificationRecipient")
  triggered_notifications   Notification[]          @relation("NotificationActor")
  sent_invites              WorkspaceInvite[]
  member_invites_sent       WorkspaceMemberInvite[] @relation("MemberInviteInviter")
  member_invites_received   WorkspaceMemberInvite[] @relation("MemberInviteTarget")
  ai_usage                  AiUsage[]
  ai_conversations          AiConversation[]
  saved_views               SavedView[]
  issue_drafts              IssueDraft[]
  checked_items             IssueChecklistItem[]    @relation("ChecklistDoneBy")
  recurring_rules           RecurringRule[]
  issue_templates           IssueTemplate[]
  report_schedules          ReportSchedule[]
}

// Rotating refresh tokens. One row per live token; revoked_at set on logout/rotation.
// Every token of one sign-in shares a `session_id` (Ф12 12.B2); null only on tokens
// issued before sessions existed.
model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  session_id String?
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session AuthSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_id])
}

// One sign-in on one device (Ф12 12.B2): lives from login through every refresh
// rotation until logout, revocation or expiry. Access tokens carry its id (`sid`),
// so revoking a session cuts the device off at its next request, not in 15 minutes.
// `ip` and `user_agent` are the latest seen (updated on refresh).
model AuthSession {
  id           String    @id @default(uuid())
  user_id      String
  // How the user signed in: password, email_code, google, github, telegram, demo.
  method       String?
  ip           String?
  user_agent   String?
  created_at   DateTime  @default(now())
  last_used_at DateTime  @default(now())
  expires_at   DateTime
  revoked_at   DateTime?

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id, revoked_at])
}

// A single login method bound to an account (auth_tz.md §2).
// `provider_user_id` is the provider's stable id (Google `sub`, GitHub numeric id,
// Telegram id); null for the `email` provider. UNIQUE(provider, provider_user_id)
// prevents the same external identity attaching to two accounts. In Postgres NULLs
// are distinct, so many `email` rows (null provider_user_id) coexist without clashing.
model AuthIdentity {
  id               String       @id @default(uuid())
  user_id          String
  provider         AuthProvider
  provider_user_id String?
  provider_email   String?
  created_at       DateTime     @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
}

// Email one-time codes for signup/login verification (auth_tz.md §6, §9).
// Only the hash of the code is stored; `attempts` caps brute force; `consumed_at`
// makes a code single-use.
//
// A code is bound to exactly one target: `email` for the signup/login flows and for
// deleting an account that has an email; `user_id` for deleting an account that has
// no email (e.g. Telegram-only), where the code is delivered through the bot instead.
// Rate-limiting and lookup key off whichever target column is set.
model EmailOtp {
  id          String          @id @default(uuid())
  email       String?
  user_id     String?
  code_hash   String
  purpose     EmailOtpPurpose
  expires_at  DateTime
  attempts    Int             @default(0)
  consumed_at DateTime?
  created_at  DateTime        @default(now())

  @@index([email])
  @@index([user_id])
}

// Telegram deep-link login handshake (auth_tz.md §7). Created `pending` and bound to
// the initiating browser session; the bot fills `telegram_id` and flips it to
// `confirmed`; the polling endpoint consumes it (`used`). One-time, short-lived.
model TelegramLoginToken {
  id          String              @id @default(uuid())
  token       String              @unique
  session_id  String
  telegram_id String?
  status      TelegramLoginStatus @default(pending)
  expires_at  DateTime
  created_at  DateTime            @default(now())

  @@index([session_id])
}

/// Журнал аудита (12.B1): кто, когда и что сделал — входы и выходы, роли и
/// подразделения, приглашения, удаления, экспорт отчётов, изменение настроек.
/// Неизменяем: триггер БД запрещает UPDATE и DELETE. Внешних ключей нет, чтобы
/// записи пережили удаление пространства или пользователя (имя автора — снимок).
model AuditLog {
  id           String   @id @default(uuid())
  /// null — событие вне пространства (вход, выход)
  workspace_id String?
  actor_id     String?
  actor_name   String?
  action       String
  target_type  String?
  target_id    String?
  meta         Json?
  ip           String?
  user_agent   String?
  created_at   DateTime @default(now())

  @@index([workspace_id, created_at])
  @@index([actor_id, created_at])
}

/// Telegram bot (ADR-011, режим 6 дней): the text the bot waits for from a chat
/// after a button — a report for «Сдать на проверку», a remark for «Вернуть», a
/// comment, a new date for «Перенести срок». One pending input per chat; it
/// expires after 15 minutes.
model TelegramPendingInput {
  chat_id    String   @id
  user_id    String
  issue_id   String
  /// submit | return | comment | deadline
  action     String
  expires_at DateTime
  created_at DateTime @default(now())
}

/// A document or photo sent to the bot, waiting to be handed in with a report.
/// Only Telegram's file reference is kept: the bytes are fetched into attachment
/// storage on hand-in, so a cancelled hand-in leaves nothing behind. Rows older
/// than 15 minutes are ignored and purged.
model TelegramPendingFile {
  id             String   @id @default(uuid())
  chat_id        String
  file_id        String
  /// null for a photo — named at hand-in («Фото 18.10.2026 14-05.jpg»)
  file_name      String?
  mime_type      String
  file_size      Int?
  caption        String?
  media_group_id String?
  created_at     DateTime @default(now())

  @@index([chat_id, created_at])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  short_name  String?
  description String?
  logo_url    String?
  // IANA zone: deadlines ("end of day") and reminder times are computed in it (ADR-012).
  timezone    String   @default("UTC")
  locale      String   @default("ru")
  // Per-workspace knobs (execution control in Ф5, notifications in Ф8).
  settings    Json     @default("{}")
  owner_id    String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  owner            User                    @relation("WorkspaceOwner", fields: [owner_id], references: [id])
  departments      Department[]
  members          WorkspaceMember[]
  projects         Project[]
  labels           Label[]
  issues           Issue[]
  cycles           Cycle[]
  modules          Module[]
  activities       ActivityLog[]
  attachments      Attachment[]
  notifications    Notification[]
  invites          WorkspaceInvite[]
  member_invites   WorkspaceMemberInvite[] @relation("WorkspaceMemberInvites")
  ai_usage         AiUsage[]
  ai_conversations AiConversation[]
  saved_views      SavedView[]
  issue_drafts     IssueDraft[]
  recurring_rules  RecurringRule[]
  issue_templates  IssueTemplate[]
  report_schedules ReportSchedule[]
  report_runs      ReportRun[]
}

model WorkspaceMember {
  workspace_id   String
  user_id        String
  role           WorkspaceRole @default(member)
  // Place in the org structure — independent of the access role (ADR-007).
  department_id  String?
  position       String?
  // Access to this workspace suspended by an admin (Ф12 12.B7, ADR-026); null = active.
  // The account itself stays as is; `deactivated_by` is the admin's user id.
  deactivated_at DateTime?
  deactivated_by String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  workspace  Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)

  @@id([workspace_id, user_id])
  @@index([user_id])
  @@index([department_id])
}

// Org structure node: Ректорат → проректоры → факультеты → кафедры / отделы (ADR-007).
model Department {
  id           String   @id @default(uuid())
  workspace_id String
  parent_id    String?
  name         String
  short_name   String?
  head_id      String?
  order        Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace      Workspace               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  parent         Department?             @relation("DepartmentTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children       Department[]            @relation("DepartmentTree")
  head           User?                   @relation("DepartmentHead", fields: [head_id], references: [id], onDelete: SetNull)
  members        WorkspaceMember[]
  projects       Project[]
  issues         Issue[]
  // Invitations that place the newcomer here (staff import, 4.B1).
  invites        WorkspaceInvite[]       @relation("InviteDepartment")
  member_invites WorkspaceMemberInvite[] @relation("MemberInviteDepartment")

  @@index([workspace_id])
  @@index([parent_id])
}

model Project {
  id            String            @id @default(uuid())
  workspace_id  String
  name          String
  identifier    String
  description   String?
  lead_id       String?
  is_archived   Boolean           @default(false)
  visibility    ProjectVisibility @default(public)
  status        ProjectStatus     @default(active)
  start_date    DateTime?
  target_date   DateTime?
  // Department that curates the project (for analytics and the org view).
  department_id String?
  icon          String?
  color         String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  // Soft delete: the project sits in the trash for 30 days (ADR-017).
  deleted_at    DateTime?
  // Who moved it to the trash (7.B6); a plain id, the person may be gone later.
  deleted_by_id String?

  workspace  Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  lead       User?           @relation("ProjectLead", fields: [lead_id], references: [id])
  department Department?     @relation(fields: [department_id], references: [id], onDelete: SetNull)
  members    ProjectMember[]
  states     State[]
  issues     Issue[]
  labels     Label[]
  cycles     Cycle[]
  modules    Module[]
  views      SavedView[]
  drafts     IssueDraft[]
  recurring  RecurringRule[]
  templates  IssueTemplate[]

  @@unique([workspace_id, identifier])
  @@index([workspace_id])
  @@index([department_id])
  @@index([deleted_at])
}

model ProjectMember {
  project_id String
  user_id    String
  role       ProjectRole @default(member)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@index([user_id])
}

model State {
  id         String     @id @default(uuid())
  project_id String
  name       String
  color      String
  group      StateGroup
  order      Int        @default(0)
  is_default Boolean    @default(false)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([project_id])
}

model Issue {
  id                String        @id @default(uuid())
  workspace_id      String
  project_id        String
  sequence_id       Int
  title             String
  description       String?
  state_id          String
  priority          IssuePriority @default(none)
  parent_id         String?
  cycle_id          String?
  estimate_points   Float?
  start_date        DateTime?
  due_date          DateTime?
  completed_at      DateTime?
  created_by_id     String
  // Поручение fields (ADR-008).
  kind              IssueKind     @default(task)
  controller_id     String?
  requires_review   Boolean       @default(false)
  // What the assignment is based on: "Протокол ректората №5 от 12.10.2026".
  basis             String?
  // Рассылка подразделениям (6.B1): the parent is marked `is_distribution`, each
  // child carries the department it is addressed to (its head is the primary assignee).
  is_distribution   Boolean       @default(false)
  department_id     String?
  // Created from an AI draft (Ф11 11.F5, ADR-028): a person reviewed and created it.
  ai_assisted       Boolean       @default(false)
  // Checklist progress «3/7» (6.B5, ADR-030): recounted with every item change,
  // so lists and boards show it without loading the items.
  checklist_total   Int           @default(0)
  checklist_done    Int           @default(0)
  // The recurring rule that created this issue (6.B4); null for anything else.
  recurring_rule_id String?
  sort_order        Float         @default(0)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  // Soft delete: the issue sits in the trash for 30 days (ADR-017, 7.B6).
  deleted_at        DateTime?
  deleted_by_id     String?

  workspace         Workspace               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project           Project                 @relation(fields: [project_id], references: [id], onDelete: Cascade)
  state             State                   @relation(fields: [state_id], references: [id])
  cycle             Cycle?                  @relation(fields: [cycle_id], references: [id], onDelete: SetNull)
  created_by        User                    @relation("IssueCreatedBy", fields: [created_by_id], references: [id])
  controller        User?                   @relation("IssueController", fields: [controller_id], references: [id], onDelete: SetNull)
  department        Department?             @relation(fields: [department_id], references: [id], onDelete: SetNull)
  parent            Issue?                  @relation("SubIssue", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Issue[]                 @relation("SubIssue")
  assignees         IssueAssignee[]
  labels            IssueLabel[]
  comments          Comment[]
  modules           ModuleIssue[]
  outgoing_links    IssueLink[]             @relation("IssueLinkSource")
  incoming_links    IssueLink[]             @relation("IssueLinkTarget")
  activities        ActivityLog[]
  attachments       Attachment[]
  notifications     Notification[]
  reviews           IssueReview[]
  deadline_requests DeadlineChangeRequest[]
  watchers          IssueWatcher[]
  reminders         ReminderLog[]
  checklist         IssueChecklistItem[]
  recurring_rule    RecurringRule?          @relation(fields: [recurring_rule_id], references: [id], onDelete: SetNull)
  // Full-text search (7.B2) uses the expression GIN index "Issue_search_idx" on
  // to_tsvector('russian', title || ' ' || coalesce(description, '')), created by
  // migration `search` — Prisma cannot describe it; keep it out of DROP INDEX diffs.
  // The title substring match has the trigram index "Issue_title_trgm_idx" on
  // translate(title, 'Ёё', 'Ее') (pg_trgm, migration `search_trgm`, 7.B7), same rule.

  @@unique([project_id, sequence_id])
  @@index([workspace_id])
  @@index([project_id])
  @@index([state_id])
  @@index([cycle_id])
  @@index([created_by_id])
  @@index([parent_id])
  @@index([priority])
  @@index([due_date])
  @@index([deleted_at])
  @@index([controller_id])
  @@index([kind])
  @@index([department_id])
  @@index([recurring_rule_id])
  @@index([workspace_id, completed_at])
}

model IssueAssignee {
  issue_id        String
  user_id         String
  // Ответственный исполнитель; the others are соисполнители (ADR-008).
  is_primary      Boolean   @default(false)
  // When the assignee confirmed they saw the assignment ("Ознакомлен", Ф5).
  acknowledged_at DateTime?
  created_at      DateTime  @default(now())

  issue Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([issue_id, user_id])
  @@index([user_id])
}

// Project-scoped labels (resolved decision — not workspace-level).
// workspace_id is denormalized for efficient multi-tenant queries.
model Label {
  id           String   @id @default(uuid())
  workspace_id String
  project_id   String
  name         String
  color        String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@index([workspace_id])
  @@index([project_id])
}

model IssueLabel {
  issue_id   String
  label_id   String
  created_at DateTime @default(now())

  issue Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  label Label @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@id([issue_id, label_id])
  @@index([label_id])
}

model Comment {
  id                String    @id @default(uuid())
  issue_id          String
  author_id         String
  body              String
  parent_comment_id String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  // When the text was last edited («изменено», 4.F8); null if never.
  edited_at         DateTime?
  deleted_at        DateTime?

  issue   Issue     @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [author_id], references: [id])
  parent  Comment?  @relation("CommentThread", fields: [parent_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Comment[] @relation("CommentThread")

  @@index([issue_id])
  @@index([author_id])
  @@index([deleted_at])
}

model Cycle {
  id           String    @id @default(uuid())
  workspace_id String
  project_id   String
  name         String
  description  String?
  start_date   DateTime?
  end_date     DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([workspace_id])
  @@index([project_id])
}

model Module {
  id           String       @id @default(uuid())
  workspace_id String
  project_id   String
  name         String
  description  String?
  status       ModuleStatus @default(backlog)
  lead_id      String?
  start_date   DateTime?
  target_date  DateTime?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  workspace Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project   Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  lead      User?         @relation("ModuleLead", fields: [lead_id], references: [id])
  issues    ModuleIssue[]

  @@index([workspace_id])
  @@index([project_id])
}

model ModuleIssue {
  module_id  String
  issue_id   String
  created_at DateTime @default(now())

  module Module @relation(fields: [module_id], references: [id], onDelete: Cascade)
  issue  Issue  @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@id([module_id, issue_id])
  @@index([issue_id])
}

model IssueLink {
  id               String        @id @default(uuid())
  issue_id         String
  related_issue_id String
  relation_type    IssueLinkType
  created_at       DateTime      @default(now())

  issue         Issue @relation("IssueLinkSource", fields: [issue_id], references: [id], onDelete: Cascade)
  related_issue Issue @relation("IssueLinkTarget", fields: [related_issue_id], references: [id], onDelete: Cascade)

  @@unique([issue_id, related_issue_id, relation_type])
  @@index([issue_id])
  @@index([related_issue_id])
}

// Audit trail: one row per recorded change. Powers the issue history feed and
// (Phase 3) notifications. Append-only — never updated after creation.
model ActivityLog {
  id           String   @id @default(uuid())
  workspace_id String
  issue_id     String?
  actor_id     String
  action       String
  field        String?
  old_value    String?
  new_value    String?
  created_at   DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  actor     User      @relation("ActivityActor", fields: [actor_id], references: [id])

  @@index([workspace_id])
  // The workspace feed (7.B3) reads the newest rows of a workspace.
  @@index([workspace_id, created_at])
  @@index([issue_id])
  @@index([actor_id])
}

// File attachments on issues. Bytes live in object storage (S3/MinIO) or, for
// local dev/test, on disk; the DB holds metadata only (TZ §5.16). `storage_key`
// is the opaque object path the storage driver resolves; it is unique so a row
// maps to exactly one stored object.
model Attachment {
  id             String   @id @default(uuid())
  workspace_id   String
  issue_id       String
  uploaded_by_id String
  file_name      String
  file_size      Int
  mime_type      String
  storage_key    String   @unique
  // Set when the file was handed in as part of a review report (Ф5).
  review_id      String?
  created_at     DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  issue       Issue        @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  uploaded_by User         @relation(fields: [uploaded_by_id], references: [id])
  review      IssueReview? @relation(fields: [review_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([issue_id])
  @@index([uploaded_by_id])
}

// In-app notifications (TZ §5.18). One row per recipient per event. Created as a
// side effect of assign / comment / mention events (the same service points that
// write the activity trail). `actor_id` is who caused it; recipients never get a
// notification for their own action. `issue_id` links to the subject issue so the
// client can deep-link; `entity_id` optionally points at the comment that
// triggered a comment/mention notification.
model Notification {
  id           String           @id @default(uuid())
  workspace_id String
  recipient_id String
  actor_id     String
  type         NotificationType
  issue_id     String?
  entity_id    String?
  is_read      Boolean          @default(false)
  read_at      DateTime?
  created_at   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  recipient User      @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  actor     User      @relation("NotificationActor", fields: [actor_id], references: [id])
  issue     Issue?    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, workspace_id, is_read])
  @@index([workspace_id])
  @@index([issue_id])
}

// Workspace invite — allows admins to invite not-yet-registered users by email.
// On creation a unique token is generated; the invitee follows a link to accept.
// Accepted and expired invites are retained for audit purposes.
model WorkspaceInvite {
  id            String        @id @default(uuid())
  workspace_id  String
  invited_by_id String
  email         String
  role          WorkspaceRole @default(member)
  // Place in the org structure and the full name the member gets on accepting —
  // set by the staff import (4.B1, ADR-031). The name fills an account without one.
  department_id String?
  position      String?
  last_name     String?
  first_name    String?
  middle_name   String?
  token         String        @unique @default(uuid())
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime      @default(now())

  workspace  Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  invited_by User        @relation(fields: [invited_by_id], references: [id])
  department Department? @relation("InviteDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([email])
  @@index([token])
}

// Invite that targets an ALREADY-REGISTERED user (distinct from the email-based
// WorkspaceInvite for strangers). An admin picks an existing account (by user_id, or
// by email for accounts that have one); the invite is delivered to every channel the
// target owns — email if they have one, Telegram if a Telegram identity is linked — and
// can be accepted from any of them. `token` is only used to address a response coming
// back through the Telegram bot (it rides in the inline-button callback_data); the
// in-app inbox and email link accept by id under an authenticated session. Accepting
// creates the WorkspaceMember; one live `pending` per (workspace, target) is enforced
// in the service.
model WorkspaceMemberInvite {
  id             String             @id @default(uuid())
  workspace_id   String
  inviter_id     String
  target_user_id String
  role           WorkspaceRole      @default(member)
  // Place in the org structure the member gets on accepting (staff import, 4.B1).
  department_id  String?
  position       String?
  status         MemberInviteStatus @default(pending)
  token          String             @unique @default(uuid())
  expires_at     DateTime
  responded_at   DateTime?
  created_at     DateTime           @default(now())

  workspace  Workspace   @relation("WorkspaceMemberInvites", fields: [workspace_id], references: [id], onDelete: Cascade)
  inviter    User        @relation("MemberInviteInviter", fields: [inviter_id], references: [id])
  target     User        @relation("MemberInviteTarget", fields: [target_user_id], references: [id], onDelete: Cascade)
  department Department? @relation("MemberInviteDepartment", fields: [department_id], references: [id], onDelete: SetNull)

  @@index([target_user_id, status])
  @@index([workspace_id])
}

// ─── Execution control (Ф5) ──────────────────────────────────────────────────

// One hand-in of an assignment for review: the assignee's report, then the
// controller's decision (approved → done, returned → back to work).
model IssueReview {
  id               String         @id @default(uuid())
  workspace_id     String
  issue_id         String
  submitted_by_id  String
  report           String?
  decision         ReviewDecision @default(pending)
  decided_by_id    String?
  decision_comment String?
  submitted_at     DateTime       @default(now())
  decided_at       DateTime?

  issue        Issue        @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  submitted_by User         @relation("ReviewSubmittedBy", fields: [submitted_by_id], references: [id])
  decided_by   User?        @relation("ReviewDecidedBy", fields: [decided_by_id], references: [id])
  attachments  Attachment[]

  @@index([issue_id])
  @@index([workspace_id, decision])
}

// Assignee asks to move the deadline; the controller approves or rejects.
model DeadlineChangeRequest {
  id               String                @id @default(uuid())
  workspace_id     String
  issue_id         String
  requested_by_id  String
  old_due_date     DateTime?
  new_due_date     DateTime
  reason           String
  status           DeadlineRequestStatus @default(pending)
  decided_by_id    String?
  decision_comment String?
  created_at       DateTime              @default(now())
  decided_at       DateTime?

  issue        Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  requested_by User  @relation("DeadlineRequestedBy", fields: [requested_by_id], references: [id])
  decided_by   User? @relation("DeadlineDecidedBy", fields: [decided_by_id], references: [id])

  @@index([issue_id])
  @@index([workspace_id, status])
}

// People following an issue (auto: author, assignees, controller, commenters).
model IssueWatcher {
  issue_id   String
  user_id    String
  created_at DateTime @default(now())

  issue Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([issue_id, user_id])
  @@index([user_id])
}

// Sent deadline reminders / escalations — the unique key makes each one fire once.
model ReminderLog {
  id         String   @id @default(uuid())
  issue_id   String
  user_id    String
  // due_soon:<days> | overdue | escalated
  kind       String
  // Local date (workspace time zone) the reminder belongs to, YYYY-MM-DD.
  for_date   String
  created_at DateTime @default(now())

  issue Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@unique([issue_id, user_id, kind, for_date])
}

/// AI assistant usage (Ф11 11.B1, ADR-028): who used which function, how much and
/// with what result. The text of the request and of the answer is never kept here.
/// The daily limit counts the `ok` rows of a user.
model AiUsage {
  id            String   @id @default(uuid())
  workspace_id  String
  user_id       String
  /// draft_issues | summary | report | ask | bot_draft
  feature       String
  provider      String
  model         String
  /// ok | error
  status        String
  error_code    String?
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  duration_ms   Int
  created_at    DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([workspace_id, created_at])
}

/// A dialogue in the AI panel (11.B5). Only its author reads it.
model AiConversation {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String
  title        String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([workspace_id, user_id, updated_at])
}

model AiMessage {
  id              String   @id @default(uuid())
  conversation_id String
  /// user | assistant
  role            String
  content         String
  /// Issues an answer links to, [{ id, key }]; checked against the reader's rights on every read.
  issue_refs      Json?
  created_at      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
}

/// Telegram «Новое поручение» (11.T1): the bot waits for the text of an assignment
/// (`text`), shows a draft (`draft`) or waits for a correction (`edit`). One per
/// chat; expires after 30 minutes. Nothing is created until «Создать».
model TelegramAiDraft {
  chat_id      String   @id
  user_id      String
  workspace_id String
  stage        String
  draft        Json?
  expires_at   DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

// A saved view (7.B4, ADR-029): a named set of page parameters — filters and how
// to show the work. With a project it opens that project's board, without — the
// workspace list (/issues). Personal views are their author's; shared ones are
// seen by everyone who sees the project and managed by admins.
model SavedView {
  id           String   @id @default(uuid())
  workspace_id String
  project_id   String?
  owner_id     String
  name         String
  // { key: string | string[] } — the page's URL filters.
  filters      Json     @default("{}")
  // { view?: board | list | calendar | timeline }.
  display      Json     @default("{}")
  is_shared    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, owner_id])
  @@index([project_id])
}

// A draft of a new issue (7.B5): the create form saved as it is typed. Personal —
// only its author sees it; «Опубликовать» turns it into an issue.
model IssueDraft {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String
  project_id   String?
  // The form as typed: title, description, kind, state, assignees, controller…
  data         Json     @default("{}")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, user_id, updated_at])
  @@index([project_id])
}

// A step of an issue's checklist (6.B5, ADR-030) — «подготовка к аккредитации»
// in seven ticks. At most 100 per issue; the issue keeps the «3/7» counters.
model IssueChecklistItem {
  id         String    @id @default(uuid())
  issue_id   String
  text       String
  is_done    Boolean   @default(false)
  done_by_id String?
  done_at    DateTime?
  order      Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  issue   Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  done_by User? @relation("ChecklistDoneBy", fields: [done_by_id], references: [id], onDelete: SetNull)

  @@index([issue_id, order])
}

// A recurring issue (6.B4, ADR-030): a copy of the create form's fields plus a
// schedule in the workspace zone. The scheduler creates one issue per due run,
// through createIssue, on behalf of the author.
model RecurringRule {
  id            String              @id @default(uuid())
  workspace_id  String
  project_id    String
  created_by_id String
  // title, description, kind, priority, assignee_ids, primary_assignee_id,
  // controller_id, requires_review, basis, label_ids, checklist.
  data          Json                @default("{}")
  // The instance is due this many days after it is created; null — no deadline.
  due_in_days   Int?
  frequency     RecurrenceFrequency
  interval      Int                 @default(1)
  // weekly: ISO weekdays, 1 = Monday … 7 = Sunday.
  by_weekday    Int[]               @default([])
  // monthly / quarterly / yearly: 1–31; past the month's end means its last day.
  by_monthday   Int?
  // yearly: 1–12.
  by_month      Int?
  // Local wall-clock time of the run, "HH:MM".
  time          String              @default("09:00")
  // Local calendar dates "YYYY-MM-DD" (ADR-012): first possible run, last one (inclusive).
  start_date    String
  until         String?
  next_run_at   DateTime?
  last_run_at   DateTime?
  // Why the latest run created nothing (an assignee was turned off…); null when it worked.
  last_error    String?
  is_active     Boolean             @default(true)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  workspace  Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_by User      @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  issues     Issue[]

  @@index([is_active, next_run_at])
  @@index([project_id])
}

// A template of a typical issue (6.B3, ADR-030): workspace-wide (project_id null)
// or of one project. The same fields as a recurring rule.
model IssueTemplate {
  id            String   @id @default(uuid())
  workspace_id  String
  project_id    String?
  created_by_id String?
  name          String
  data          Json     @default("{}")
  due_in_days   Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_by User?     @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, project_id])
  @@index([project_id])
}

// A report sent by itself (Ф10 10.B5, ADR-032): «каждый понедельник в 08:00
// справка за прошлую неделю ректору в Telegram и на почту». The document is built
// with its author's rights at the time of sending.
model ReportSchedule {
  id            String              @id @default(uuid())
  workspace_id  String
  created_by_id String
  // Optional own name; the client shows the document's name otherwise.
  name          String?
  report        ReportKind
  // Analytics filters (10.B1): { department?: string[], project?: string[], kind? }.
  filters       Json                @default("{}")
  period        ReportPeriod
  // daily / weekly / monthly / quarterly (yearly is not offered).
  frequency     RecurrenceFrequency
  // weekly: ISO weekdays, 1 = Monday … 7 = Sunday.
  by_weekday    Int[]               @default([])
  // monthly / quarterly: 1–31; past the month's end means its last day.
  by_monthday   Int?
  // Local wall-clock time, "HH:MM", in the workspace zone.
  time          String              @default("08:00")
  // Anchor of the schedule math (a quarter's first day for quarterly reports).
  start_date    String
  // Users who receive it; without a foreign key — who is still an active member
  // is checked at sending time.
  recipient_ids String[]            @default([])
  // "telegram" and/or "email"; the in-app notification is always made.
  channels      String[]            @default([])
  next_run_at   DateTime?
  last_run_at   DateTime?
  // Why the latest run sent nothing (or the pause reason); null when it worked.
  last_error    String?
  is_active     Boolean             @default(true)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  workspace  Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  created_by User        @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  runs       ReportRun[]

  @@index([is_active, next_run_at])
  @@index([workspace_id])
}

// One sending of a planned report: the period, the key figures, the stored file
// and how it was delivered to each recipient. The latest 12 are kept.
model ReportRun {
  id              String          @id @default(uuid())
  workspace_id    String
  schedule_id     String
  // Who pressed «Отправить сейчас»; null — sent by the schedule.
  triggered_by_id String?
  // Local dates "YYYY-MM-DD", inclusive.
  period_from     String
  period_to       String
  status          ReportRunStatus
  error           String?
  file_name       String?
  mime_type       String?
  file_size       Int?
  storage_key     String?         @unique
  // Figures of the message: created, completed, on_time, late, overdue, discipline.
  summary         Json            @default("{}")
  recipient_ids   String[]        @default([])
  // [{ user_id, channel: telegram | email, status: sent | failed | skipped, error? }]
  deliveries      Json            @default("[]")
  created_at      DateTime        @default(now())

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  schedule  ReportSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, created_at])
  @@index([workspace_id])
}
